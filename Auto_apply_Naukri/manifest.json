{
  "manifest_version": 3,
  "name": "Naukri Apply Helper",
  "version": "0.2.0",
  "description": "Fill common job application fields from a profile stored on your device.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.naukri.com/*", "https://naukri.com/*"],
  "action": {
    "default_title": "Naukri Apply Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*", "https://naukri.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
